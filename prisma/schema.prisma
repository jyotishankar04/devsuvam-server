// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Blogs {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  image     String   @default("http://choseandclick.com/image/cache/catalog/basel-demo/blog-1140x700.png")
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags        String[]
  description String?

  @@index([slug])
}
